# Godot 4+ specific ignores
.godot/

# Dev screenshots from dev-tools/capture_scene.gd
.captures/
tools/

# Claude Code session data and worktrees; project skills are shared
.claude/*
!.claude/skills/

# The pilot's screenshots and log (dev-tools/pilot.gd)
.pilot/

# Textures Godot extracts from the Rocketbox .glb files on import; the .glb
# files carry them, and a fresh import writes these again.
assets/rocketbox/*.jpg
assets/rocketbox/*.png
assets/rocketbox/*.jpg.import
assets/rocketbox/*.png.import

# Throwaway visual mock-ups
mockup_tmp/
